# 复制成 .env 后填上真实密码再启动：
#     cp .env.example .env
#
# compose.yaml 会读同目录的 .env。没有这个文件的话，两个变量会是空串，
# MySQL 容器会以 "Database is uninitialized and password option is not specified" 退出。
#
# 注意：MYSQL_PASSWORD 要和 che168_to_db/che168_to_db/settings.py 里
# DB_CONFIG['password'] 保持一致，否则爬虫连不上。

# root 账号密码（只在容器内部/运维时用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# scrapy_user 的密码（爬虫用这个账号连）
MYSQL_PASSWORD=CHANGE_ME_scrapy_password
